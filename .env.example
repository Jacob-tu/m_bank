# ================================================================
# M-Bank 环境变量配置模板
# 使用方式：
#   cp .env.example .env
#   编辑 .env 填入真实值
#   .env 文件已在 .gitignore 中忽略，禁止提交到版本库
# ================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=MBank@Root2024
MYSQL_DATABASE=mbank
MYSQL_USER=mbank
MYSQL_PASSWORD=MBank@Pass2024
MYSQL_PORT=3306

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080

# ---- JWT（必须替换为安全的随机密钥）----
# 生成方式：openssl rand -base64 64
MBANK_JWT_SECRET=请替换为Base64编码的256位以上随机密钥
MBANK_JWT_EXPIRATION_HOURS=24

# ---- 安全策略 ----
MBANK_SECURITY_MAX_LOGIN_ATTEMPTS=5
MBANK_SECURITY_LOCK_DURATION_MINUTES=15

# ---- SMS（生产环境需接入真实短信服务商）----
MBANK_SMS_MOCK_ENABLED=false

# ---- Nginx 端口 ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
